# Copy this file to ".env" and edit. Without these settings the app runs in demo mode (offline simulator).

# --- Groq API KEY ----------------------------------------------------------------
# API_KEY=gsk_your_groq_api_key
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=your_selected_groq_model_id

# Local with Ollama (no real key needed) ---------------------------------------------
# Run `ollama pull qwen2.5-coder:7b` first.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:7b

# --- Optional ----------------------------------------------------------------------------------
# OPENAI_TIMEOUT=300            # seconds per request; raise for slow local models
# TEXTGRAD_SQL_CACHE=0          # disable the on-disk response cache (default: on)
